{
  "name": "bug-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Bug Agent for Bitbucket PR diff analysis",
  "main": "bug-agent.ts",
  "scripts": {
    "start": "bun run bug-agent.ts",
    "dev": "bun --watch bug-agent.ts",
    "lint": "eslint .",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/moonshotai": "^2.0.10",
    "ai": "^6.0.116",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "bun-types": "^1.3.11",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
