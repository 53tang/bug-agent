# Server
PORT=3002

# Bitbucket API credentials
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=
BITBUCKET_WORKSPACE=smart_eco-platform

# Moonshot (Kimi) — required for analysis
MOON_SHOT_KEY=

# Optional: web search during recheck
TAVILY_API_KEY=

# 5 * 60 * 1000 (5 min)
PR_FETCH_INTERVAL_MS=300000

# Comma-separated Bitbucket user UUIDs for PR author filter (optional; defaults in code if empty)
PR_AUTHOR_UUIDS=
